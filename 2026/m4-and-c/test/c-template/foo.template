dnl 测试
int main(void) {
        size_t n = 7;
        /* 整型数组 a */
        _var(a, Array(int) *,array_new(int)(n));
        for (size_t i = 0; i < n; i++) a->body[i] = i + 1;
        array_print(int)(a);
        array_free(a);
        /* 双精度浮点型数组 b */
        _var(b, Array(double) *,array_new(double)(n));
        for (size_t i = 0; i < n; i++) b->body[i] = i + 1;
        array_print(double)(b);
        array_free(b);
        return 0;
}